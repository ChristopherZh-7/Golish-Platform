{
  "$schema": "../../../docs/design/2026-05-26-stage-harness-mvp-external-attack-surface.md#2",
  "$comment": "Profile: Cloud Assessment. L3 vuln validation, cloud exposure review. Phase A.",

  "id": "cloud_assessment",
  "display_name": "Cloud Assessment",
  "max_authorization": "vuln_validation",

  "allowed_stage_kinds": [
    "scoping",
    "target_intel",
    "external_attack_surface",
    "enumeration",
    "vuln_triage",
    "reporting"
  ],

  "forbidden_stage_kinds": [
    "verification",
    "access_validation",
    "internal_discovery",
    "objective_pathing",
    "objective_simulation",
    "cleanup"
  ],

  "approval_policy": {
    "before_active_scan": true,
    "before_scope_expansion": true
  },

  "cleanup_required": false,
  "evidence_required": true,

  "scoping_policy": {
    "require_subject": true,
    "subject_kind": "cloud_tenant",
    "require_unit_candidates": false,
    "asset_confirmation": "interactive",
    "require_human_scope_approval": true,
    "write_organizations": false
  }
}
