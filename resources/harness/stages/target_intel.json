{
  "$schema": "../../../docs/design/2026-05-26-stage-harness-mvp-external-attack-surface.md#4.1",
  "$comment": "Stage spec: target_intel. Passive intel collection (DNS / ASN / whois / CT). L1 passive_intel. Phase A.",

  "id": "target_intel",
  "kind": "target_intel",
  "risk_level": "low",

  "requires_stages": ["scoping"],
  "allowed_next_stages": ["external_attack_surface"],

  "allowed_tool_types": ["recon/dns", "recon/subdomain", "recon/osint", "recon/url-history"],

  "deliverable_schema": "StageDeliverable",
  "gate_validator": "validate_stage_gate",

  "gate_rules": [
    {
      "op": "for_all",
      "over": "claims",
      "require": { "pred": "non_empty", "field": "evidence_ids" },
      "on_fail": { "reason": "every claim must cite evidence", "hints": ["add evidence to each claim via prior tool calls"] }
    },
    {
      "op": "for_all",
      "over": "findings",
      "require": { "pred": "non_empty", "field": "evidence_refs" },
      "on_fail": { "reason": "every finding must cite evidence", "hints": ["add evidence to each finding via prior tool calls"] }
    }
  ],

  "min_invocations": {
    "dns_resolve": 1
  },

  "max_other_skips": 2,

  "human_approval": {
    "required_before": ["active_scan"]
  },

  "agent_continuity": "single_session",

  "inherits_evidence_from": [
    {
      "stage_kind": "scoping",
      "evidence_kinds": ["scope_rule"]
    }
  ]
}
