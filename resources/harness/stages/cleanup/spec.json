{
  "$schema": "../../../../docs/design/2026-05-26-stage-harness-mvp-external-attack-surface.md#4.1",
  "$comment": "Stage spec: cleanup. L5 red-team artifact cleanup before reporting. Cleanup required by red_team profile. Phase A.",

  "id": "cleanup",
  "kind": "cleanup",
  "risk_level": "medium",

  "requires_stages": ["objective_simulation"],
  "allowed_next_stages": ["reporting"],

  "allowed_tool_types": [],

  "deliverable_schema": "StageDeliverable",
  "gate_validator": "validate_stage_gate",

  "gate_rules": [
    {
      "op": "for_all",
      "over": "claims",
      "require": { "pred": "non_empty", "field": "evidence_ids" },
      "on_fail": { "reason": "every claim must cite evidence", "hints": ["add evidence to each claim via prior tool calls"] }
    },
    {
      "op": "for_all",
      "over": "findings",
      "require": { "pred": "non_empty", "field": "evidence_refs" },
      "on_fail": { "reason": "every finding must cite evidence", "hints": ["add evidence to each finding via prior tool calls"] }
    }
  ],

  "min_invocations": {},

  "max_other_skips": 1,

  "human_approval": {
    "required_before": []
  },

  "agent_continuity": "multi_session_relay",

  "inherits_evidence_from": [
    {
      "stage_kind": "objective_simulation",
      "evidence_kinds": ["simulation_result"]
    }
  ]
}
