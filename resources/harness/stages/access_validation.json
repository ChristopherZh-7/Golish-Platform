{
  "$schema": "../../../docs/design/2026-05-26-stage-harness-mvp-external-attack-surface.md#4.1",
  "$comment": "Stage spec: access_validation. L5 red-team foothold validation. Approval-gated, cleanup required. Phase A.",

  "id": "access_validation",
  "kind": "access_validation",
  "risk_level": "critical",

  "requires_stages": ["verification"],
  "allowed_next_stages": ["internal_discovery"],

  "allowed_tool_types": ["exploit", "post-exploit/lateral-movement"],

  "deliverable_schema": "StageDeliverable",
  "gate_validator": "validate_stage_gate",

  "required_checks": [
    "scope_status_present",
    "evidence_non_empty",
    "out_of_scope_targets_excluded"
  ],

  "min_invocations": {},

  "max_other_skips": 1,

  "human_approval": {
    "required_before": ["post_exploit", "exploit_validation"]
  },

  "agent_continuity": "multi_session_relay",

  "inherits_evidence_from": [
    {
      "stage_kind": "verification",
      "evidence_kinds": ["exploit_proof"]
    }
  ]
}
