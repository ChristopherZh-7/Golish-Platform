{
  "$schema": "../../../docs/design/2026-05-26-stage-harness-mvp-external-attack-surface.md#4.1",
  "$comment": "Stage spec: external_attack_surface (Doc 3 §4.1). MVP stage. Doc 3 §4.2 5 个问题: input/output/allowed_tools/done_judgement/failure-out_of_scope.",

  "id": "external_attack_surface",
  "kind": "external_attack_surface",
  "risk_level": "medium",

  "requires_stages": ["scoping", "target_intel"],
  "allowed_next_stages": ["enumeration", "reporting"],

  "allowed_tool_types": ["recon/dns", "recon/subdomain", "recon/http", "recon/url-history", "recon/visual"],

  "deliverable_schema": "ExternalAttackSurfaceDeliverable",
  "gate_validator": "validate_external_attack_surface_gate",

  "gate_rules": [
    {
      "op": "for_all",
      "over": "claims",
      "require": { "pred": "non_empty", "field": "evidence_ids" },
      "on_fail": { "reason": "every claim must cite evidence", "hints": ["add evidence to each claim via prior tool calls"] }
    },
    {
      "op": "for_all",
      "over": "findings",
      "require": { "pred": "non_empty", "field": "evidence_refs" },
      "on_fail": { "reason": "every finding must cite evidence", "hints": ["add evidence to each finding via prior tool calls"] }
    },
    { "op": "named_check", "check": "surface_coverage" },
    { "op": "named_check", "check": "min_invocations" }
  ],

  "min_invocations": {
    "dns_resolve": 1,
    "http_probe": 1,
    "subdomain_enum_passive": 1
  },

  "max_other_skips": 2,

  "human_approval": {
    "required_before": ["active_scan", "exploit_validation"]
  },

  "agent_continuity": "single_session",

  "inherits_evidence_from": [
    {
      "stage_kind": "target_intel",
      "evidence_kinds": ["dns_a", "asn", "whois"]
    }
  ]
}
