{
  "$schema": "../../../docs/design/2026-05-26-stage-harness-mvp-external-attack-surface.md#4.1",
  "$comment": "Stage spec: objective_pathing. L5 red-team path planning toward objective. Approval-gated. Phase A.",

  "id": "objective_pathing",
  "kind": "objective_pathing",
  "risk_level": "critical",

  "requires_stages": ["internal_discovery"],
  "allowed_next_stages": ["objective_simulation"],

  "allowed_tool_types": ["post-exploit/ad-tools"],

  "deliverable_schema": "StageDeliverable",
  "gate_validator": "validate_stage_gate",

  "required_checks": [
    "scope_status_present",
    "evidence_non_empty",
    "out_of_scope_targets_excluded"
  ],

  "min_invocations": {},

  "max_other_skips": 1,

  "human_approval": {
    "required_before": ["post_exploit", "exploit_validation"]
  },

  "agent_continuity": "multi_session_relay",

  "inherits_evidence_from": [
    {
      "stage_kind": "internal_discovery",
      "evidence_kinds": ["internal_host", "privilege"]
    }
  ]
}
