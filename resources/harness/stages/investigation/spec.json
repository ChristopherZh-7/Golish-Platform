{
  "$schema": "../../../../docs/design/2026-08-02-rag-first-unified-investigation-stage.md#5-stage-与operation-graph",
  "$comment": "Mandatory company -> asset queue Investigation contract. Each active asset owns one durable Primary, a Primary-authored dynamic cognitive team, a dynamic hypothesis backlog and real operator execution.",

  "id": "investigation",
  "kind": "investigation",
  "risk_level": "critical",

  "requires_stages": ["application_understanding"],
  "allowed_next_stages": ["reporting"],

  "allowed_tool_types": [],
  "deliverable_schema": "InvestigationRunClosureV1",
  "gate_validator": "validate_investigation_gate",
  "findings_allowed": false,
  "specialist": "investigation",
  "$comment_team_scheduler": "The TeamPlan is a company envelope. The current asset lane owns one durable Primary which may request zero to eight asset-bound cognitive or verification subtasks. Roles may repeat or be omitted and never form a business barrier. Analysis is read-only. Verification discovers the installed/ready inventory from the existing Tool Manager and runs it under the current asset-session authority; there is no Investigation-only tool catalog or per-hypothesis Primary fallback.",
  "team_scheduler": {
    "schema_version": 1,
    "enabled_in_v2_only": true,
    "coordination_mode": "investigation_task_orchestrator",
    "allowed_roles": [
      "investigation",
      "researcher",
      "browser",
      "pentester",
      "adviser",
      "coder",
      "installer",
      "enricher",
      "memorist"
    ],
    "aggregator_kind": "investigation_primary",
    "aggregator_role": "investigation",
    "max_company_units_active": 1,
    "global_provider_cap": 4,
    "max_workers": 8,
    "max_dynamic_requests": 64,
    "allowed_dynamic_request_kinds": [
      "analysis_task",
      "verification_task",
      "cognitive_support"
    ],
    "max_dynamic_subject_refs": 32,
    "risk_lane": "asset_phase_bound"
  },
  "coverage_axis": ["HYPOTHESIS", "VERIFICATION_OBLIGATION"],

  "gate_rules": [],
  "min_invocations": {},
  "max_other_skips": 0,
  "human_approval": { "required_before": [] },
  "agent_continuity": "multi_session_relay",

  "inherits_evidence_from": [
    {
      "stage_kind": "application_understanding",
      "evidence_kinds": ["application_model"]
    },
    {
      "stage_kind": "vuln_triage",
      "evidence_kinds": ["formulaic_observation"]
    }
  ]
}
