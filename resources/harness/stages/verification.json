{
  "$schema": "../../../docs/design/2026-05-26-stage-harness-mvp-external-attack-surface.md#4.1",
  "$comment": "Stage spec: verification. L4 controlled exploit validation. Approval-gated. Phase A.",

  "id": "verification",
  "kind": "verification",
  "risk_level": "critical",

  "requires_stages": ["vuln_triage"],
  "allowed_next_stages": ["access_validation", "reporting"],

  "allowed_tools": [
    "query_target_data",
    "exploit_validation",
    "log_operation",
    "log_scan_result",
    "submit_stage_deliverable"
  ],

  "forbidden_tools": [
    "credential_attack",
    "destructive_action",
    "persistence"
  ],

  "deliverable_schema": "StageDeliverable",
  "gate_validator": "validate_stage_gate",

  "required_checks": [
    "scope_status_present",
    "evidence_non_empty",
    "out_of_scope_targets_excluded"
  ],

  "min_invocations": {},

  "max_other_skips": 1,

  "human_approval": {
    "required_before": ["exploit_validation"]
  },

  "agent_continuity": "single_session",

  "inherits_evidence_from": [
    {
      "stage_kind": "vuln_triage",
      "evidence_kinds": ["vuln_finding"]
    }
  ],

  "$comment_p2": "P2 verification-gate SAMPLE — tune to taste. required_evidence_kinds: this stage's cited evidence must include these kinds (ledger-checked). finding_verification: findings at/above min_severity must carry evidence, and (when set) one of require_evidence_kinds. Fill the other 11 stage specs the same way to define each stage's pass-criteria.",
  "required_evidence_kinds": ["exploit_verified"],
  "finding_verification": {
    "min_severity": "high",
    "require_evidence_kinds": ["poc", "exploit_verified"]
  }
}
