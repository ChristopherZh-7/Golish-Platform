{
  "$schema": "../../../../docs/design/2026-05-26-stage-harness-mvp-external-attack-surface.md#4.1",
  "$comment": "C6/P6b: consume exact active Foothold work items and persist typed internal observations through one lease-fenced canonical-fact wrapper.",

  "id": "internal_discovery",
  "kind": "internal_discovery",
  "risk_level": "critical",
  "specialist": "post_exploit_operator",

  "requires_stages": ["access_validation"],
  "allowed_next_stages": ["objective_pathing"],

  "allowed_tool_types": ["post_exploit_record_internal_observation"],

  "deliverable_schema": "StageDeliverable",
  "gate_validator": "validate_stage_gate",

  "findings_allowed": false,

  "post_exploit_policy": {
    "p6a_only": false,
    "allowed_side_effect_classes": ["none"],
    "requires_cleanup_kernel_for_side_effects": true,
    "work_item_kind": "foothold",
    "canonical_rows": ["footholds", "internal_asset_observations", "audit_log"]
  },

  "gate_rules": [
    {
      "op": "for_all",
      "over": "claims",
      "require": { "pred": "non_empty", "field": "evidence_ids" },
      "on_fail": { "reason": "claim evidence ids are optional; cited ids, if any, must be real", "hints": ["omit evidence_ids unless a real ledger id is explicitly available"] }
    },
    {
      "op": "for_all",
      "over": "findings",
      "require": { "pred": "non_empty", "field": "evidence_refs" },
      "on_fail": { "reason": "finding evidence ids are optional; cited ids, if any, must be real", "hints": ["omit evidence_refs unless a real ledger id is explicitly available"] }
    }
  ],

  "min_invocations": {"post_exploit_record_internal_observation": 1},

  "max_other_skips": 1,

  "human_approval": { "required_before": [] },

  "agent_continuity": "multi_session_relay",

  "inherits_evidence_from": [
    {
      "stage_kind": "access_validation",
      "evidence_kinds": ["foothold"]
    }
  ]
}
