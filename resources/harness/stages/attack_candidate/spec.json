{
  "$schema": "../../../../docs/design/2026-07-02-attack-stage-formulaic-candidate-exploit.md#3.3",
  "$comment": "Candidate V2 Wave entry is a sealed union: the initial Wave uses entry_kind=vuln_triage_handoff; a follow-on Wave uses entry_kind=fact_delta_consolidation and never fabricates a vuln_triage handoff. Every nonterminal org decides its exact frozen manifest. A zero-input org in any Wave is already terminal and receives no fake empty manifest or reasoning worker. Final Gate PASS lets the server derive immutable Candidate identity/plan/hash/risk, then enters durable review and durable resume before Verification.",

  "id": "attack_candidate",
  "kind": "attack_candidate",
  "risk_level": "medium",

  "requires_stages": ["vuln_triage"],
  "allowed_next_stages": ["verification", "reporting"],

  "allowed_tool_types": [],

  "deliverable_schema": "StageDeliverable",
  "gate_validator": "validate_stage_gate",

  "findings_allowed": false,

  "gate_rules": [
    {
      "op": "for_all",
      "over": "claims",
      "require": { "pred": "non_empty", "field": "evidence_ids" },
      "on_fail": { "reason": "claim evidence ids are optional; cited ids, if any, must be real", "hints": ["omit evidence_ids unless a real ledger id is explicitly available"] }
    },
    {
      "op": "candidate_grounded",
      "require_evidence": true,
      "on_fail": { "reason": "every server-seeded work item must end exactly once as candidate or evidence-backed no_candidate", "hints": ["use the exact work_item_key and cite observation evidence from that work item"] }
    }
  ],

  "specialist": "analyst",
  "candidate_analysis_team": {
    "schema_version": 1,
    "controller_role": "candidate_hypothesis_controller",
    "analyst_role": "candidate_hypothesis_analyst",
    "critic_role": "merge_conflict_critic",
    "final_submitter_role": "candidate_hypothesis_controller",
    "min_live_analysis_lanes": 2,
    "max_live_analysis_lanes": 8,
    "single_lane_input_limit": 12,
    "max_inputs_per_microbatch": 24,
    "chunking_contract_version": 1,
    "redaction_contract_version": 1,
    "attack_class_checklist_contract_version": 1,
    "trust_boundary_checklist_contract_version": 1,
    "coverage_partition_contract_version": 1,
    "coverage_synthesis_contract_version": 1,
    "hypothesis_coverage_sampling_contract_version": 1,
    "require_checked_tool_truth_temporal_authority": true,
    "knowledge_feed_snapshot_contract_version": 1,
    "product_version_match_contract_version": 1,
    "max_knowledge_feed_age_seconds": 86400,
    "require_signed_knowledge_feeds": true,
    "required_tool_truth_root_families": ["eas", "enum", "vuln"],
    "max_source_bytes_per_input": 1048576,
    "max_chunk_bytes": 16384,
    "max_chunks_per_input": 64,
    "max_chunks_per_coverage_partition": 4,
    "max_coverage_subreview_work_items": 4096,
    "max_synthesis_inputs_per_partition": 32,
    "max_proposals_per_artifact": 16,
    "max_controller_page_size": 64,
    "max_attempts_per_work_item": 2,
    "max_analysis_attempts": 2,
    "require_read_only_children": true,
    "require_tool_free_children": true
  },
  "coverage_axis": ["CANDIDATES"],

  "min_invocations": {},
  "max_other_skips": 3,

  "$comment_human_approval": "This reasoning stage has no generic exploit approval. Under exact V2Only, durable review binds approve/reject to the exact immutable Candidate plan and DB-backed resume is the only authority that releases Verification.",
  "human_approval": { "required_before": [] },

  "agent_continuity": "single_session",

  "inherits_evidence_from": [
    { "stage_kind": "vuln_triage", "evidence_kinds": ["formulaic_observation"] },
    { "stage_kind": "enumeration", "evidence_kinds": ["http_service", "api_endpoint", "dir_entry"] }
  ]
}
