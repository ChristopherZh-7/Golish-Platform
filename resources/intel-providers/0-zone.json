{
  "tool": {
    "id": "0.zone",
    "name": "0.zone（零零信安）",
    "description": "Chinese cyberspace mapping and threat intelligence provider exposed to Asset Intel through a JSON-declared HTTP runtime.",
    "executable": "",
    "runtime": "native",
    "launchMode": "cli",
    "category": "recon",
    "subcategory": "osint",
    "tags": ["recon", "osint", "asm", "http-json", "credential-required"],
    "pentestPhase": ["recon"],
    "tier": "recommended",
    "asset_intel": {
      "enabled": true,
      "provider_id": "0.zone",
      "display_name": "0.zone（零零信安）",
      "capabilities": ["domains", "apps", "contacts"],
      "lookup": {
        "enabled": true,
        "skill_id": "org",
        "timeout_secs": 30,
        "normalize": {
          "path": "$..data[*]",
          "name": ["name_cn", "company", "group"],
          "credit_code": "msg.code",
          "industry": "msg.industry",
          "legal_representative": "msg.legal_person",
          "address": "msg.address",
          "registered_at": "msg.registered_at",
          "default_confidence": 0.64
        }
      },
      "requires_integration": {
        "tool_id": "0.zone",
        "group_ids": ["default"]
      },
      "auto": {
        "default": true,
        "priority": 90
      },
      "runtime": {
        "kind": "http_json",
        "request_delay_ms": 700,
        "max_retries": 2,
        "requests": [
          {
            "id": "domain",
            "method": "POST",
            "url": "https://0.zone/api/data/",
            "headers": {
              "Content-Type": "application/json",
              "User-Agent": "Golish Asset Intel"
            },
            "json": {
              "query": "{{company_name}}",
              "query_type": "domain",
              "page": 1,
              "pagesize": 40,
              "zone_key_id": "{{secret:api_key}}"
            },
          "timeout_secs": 30,
          "applicable_pivot_kinds": ["company_name", "brand"],
          "wire_query_type": "domain",
          "adapter_version": "http_semantic.v1",
          "literal_encoder": "zone_exact_literal.v1"
          },
          {
            "id": "domain_root",
            "method": "POST",
            "url": "https://0.zone/api/data/",
            "headers": {
              "Content-Type": "application/json",
              "User-Agent": "Golish Asset Intel"
            },
            "json": {
              "query": "root_domain=={{domain}}",
              "query_type": "domain",
              "page": 1,
              "pagesize": 40,
              "zone_key_id": "{{secret:api_key}}"
            },
          "timeout_secs": 30,
          "applicable_pivot_kinds": ["domain", "hostname"],
          "wire_query_type": "domain",
          "adapter_version": "http_semantic.v1",
            "literal_encoder": "zone_exact_literal.v1"
          },
          {
            "id": "site_ip",
            "method": "POST",
            "url": "https://0.zone/api/data/",
            "headers": {"Content-Type": "application/json", "User-Agent": "Golish Asset Intel"},
            "json": {
              "query": "ip=={{company_name}}",
              "query_type": "site",
              "page": 1,
              "pagesize": 40,
              "zone_key_id": "{{secret:api_key}}"
            },
            "timeout_secs": 30,
            "applicable_pivot_kinds": ["ip"],
            "wire_query_type": "site",
            "adapter_version": "http_semantic.v1",
            "literal_encoder": "zone_exact_literal.v1"
          },
          {
            "id": "site_asn",
            "method": "POST",
            "url": "https://0.zone/api/data/",
            "headers": {"Content-Type": "application/json", "User-Agent": "Golish Asset Intel"},
            "json": {
              "query": "asn=={{company_name}}",
              "query_type": "site",
              "page": 1,
              "pagesize": 40,
              "zone_key_id": "{{secret:api_key}}"
            },
            "timeout_secs": 30,
            "applicable_pivot_kinds": ["asn"],
            "wire_query_type": "asn",
            "adapter_version": "http_semantic.v1",
            "literal_encoder": "zone_exact_literal.v1"
          },
          {
            "id": "apk",
            "method": "POST",
            "url": "https://0.zone/api/data/",
            "headers": {
              "Content-Type": "application/json",
              "User-Agent": "Golish Asset Intel"
            },
            "json": {
              "query": "{{company_name}}",
              "query_type": "apk",
              "page": 1,
              "pagesize": 40,
              "zone_key_id": "{{secret:api_key}}"
            },
          "timeout_secs": 30,
          "applicable_pivot_kinds": ["company_name", "brand", "app_id"],
          "wire_query_type": "apk",
          "adapter_version": "http_semantic.v1",
          "literal_encoder": "zone_exact_literal.v1"
          },
          {
            "id": "org",
            "method": "POST",
            "url": "https://0.zone/api/data/",
            "headers": {
              "Content-Type": "application/json",
              "User-Agent": "Golish Asset Intel"
            },
            "json": {
              "query": "{{company_name}}",
              "query_type": "org",
              "page": 1,
              "pagesize": 20,
              "zone_key_id": "{{secret:api_key}}"
            },
          "timeout_secs": 30,
          "applicable_pivot_kinds": ["company_name", "brand"],
          "wire_query_type": "org",
          "adapter_version": "http_semantic.v1",
          "literal_encoder": "zone_exact_literal.v1"
          },
          {
            "id": "email",
            "method": "POST",
            "url": "https://0.zone/api/data/",
            "headers": {
              "Content-Type": "application/json",
              "User-Agent": "Golish Asset Intel"
            },
            "json": {
              "query": "{{company_name}}",
              "query_type": "email",
              "page": 1,
              "pagesize": 40,
              "zone_key_id": "{{secret:api_key}}"
            },
          "timeout_secs": 30,
          "applicable_pivot_kinds": ["company_name", "email_domain"],
          "wire_query_type": "email",
          "adapter_version": "http_semantic.v1",
          "literal_encoder": "zone_exact_literal.v1"
          },
          {
            "id": "member",
            "method": "POST",
            "url": "https://0.zone/api/data/",
            "headers": {
              "Content-Type": "application/json",
              "User-Agent": "Golish Asset Intel"
            },
            "json": {
              "query": "{{company_name}}",
              "query_type": "member",
              "page": 1,
              "pagesize": 40,
              "zone_key_id": "{{secret:api_key}}"
            },
          "timeout_secs": 30,
          "applicable_pivot_kinds": ["company_name"],
          "wire_query_type": "member",
          "adapter_version": "http_semantic.v1",
          "literal_encoder": "zone_exact_literal.v1"
          }
        ]
      },
      "normalize": {
        "pairs": [
          {
            "path": "$..data[*]",
            "host_field": ["domain", "root_domain"],
            "ip_field": ["msg.ip"]
          }
        ],
        "organization": [
          {
            "path": "$..data[*]",
            "label": ["company", "group"],
            "value": ["company", "group"],
            "confidence": 0.64
          }
        ],
        "target": [
          {
            "path": "$..data[*]",
            "label": ["domain", "root_domain", "url"],
            "value": ["domain", "root_domain"],
            "confidence": 0.72
          }
        ],
        "profile_fields": [
          {
            "path": "$..data[*]",
            "source_field": "domain",
            "target_field": "domains",
            "transform": "lower",
            "when": [{ "field": "domain", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "root_domain",
            "target_field": "domains",
            "transform": "lower",
            "when": [{ "field": "root_domain", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.ip",
            "target_field": "ip_ranges",
            "transform": "trim",
            "when": [{ "field": "msg.ip", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": ["domain", "root_domain"],
            "target_field": "business_systems",
            "transform": "trim",
            "when": [{ "field": "domain", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": ["msg.app_url", "msg.app_id"],
            "target_field": "mobile_apps",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "msg.app_url", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": ["title", "msg.wechat_id"],
            "target_field": "wechat_official_accounts",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "msg.wechat_id", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.domain_list[0]",
            "target_field": "app_domains",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "msg.domain_list[0]", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.code",
            "target_field": "credit_code",
            "transform": "trim",
            "when": [
              { "field": "msg.code", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.industry",
            "target_field": "industry",
            "transform": "trim",
            "when": [
              { "field": "msg.industry", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.legal_person",
            "target_field": "legal_representative",
            "target_kind": "intel",
            "transform": "trim",
            "when": [
              { "field": "msg.legal_person", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.reg_address",
            "target_field": "registered_address",
            "target_kind": "intel",
            "transform": "trim",
            "when": [
              { "field": "msg.reg_address", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.reg_time",
            "target_field": "registered_at",
            "target_kind": "intel",
            "transform": "trim",
            "when": [
              { "field": "msg.reg_time", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.capital",
            "target_field": "registered_capital",
            "target_kind": "intel",
            "transform": "trim",
            "when": [
              { "field": "msg.capital", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.business",
            "target_field": "business_scope",
            "target_kind": "intel",
            "transform": "trim",
            "when": [
              { "field": "msg.business", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.email[0]",
            "target_field": "email",
            "target_kind": "contact",
            "transform": "lower",
            "when": [
              { "field": "msg.email[0]", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.website[0]",
            "target_field": "domains",
            "transform": "lower",
            "when": [
              { "field": "msg.website[0]", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.contact_number",
            "target_field": "phone",
            "target_kind": "contact",
            "transform": "trim",
            "when": [
              { "field": "msg.contact_number", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "beian",
            "target_field": "icp_records",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "beian", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.beian",
            "target_field": "icp_records",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "msg.beian", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "cname",
            "target_field": "cname",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "cname", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "operator",
            "target_field": "operator",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "operator", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "cms",
            "target_field": "cms",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "cms", "op": "ne", "value": "unknown" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "component",
            "target_field": "component",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "component", "op": "ne", "value": "unknown" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "server_name",
            "target_field": "server_name",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "server_name", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "server_version",
            "target_field": "server_version",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "server_version", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "service",
            "target_field": "service",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "service", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "protocol",
            "target_field": "protocol",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "protocol", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "asn_org",
            "target_field": "asn_org",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{ "field": "asn_org", "op": "exists", "value": "" }]
          },
          {
            "path": "$..data[*]",
            "source_field": "email",
            "target_field": "exposed_emails",
            "target_kind": "intel",
            "transform": "lower",
            "when": [
              { "field": "email", "op": "exists", "value": "" },
              { "field": "email_type", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "mail_domain",
            "target_field": "email_domains",
            "transform": "lower",
            "when": [
              { "field": "mail_domain", "op": "exists", "value": "" },
              { "field": "email_type", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "leakage_num",
            "target_field": "email_leakage_total",
            "target_kind": "intel",
            "transform": "trim",
            "when": [
              { "field": "leakage_num", "op": "exists", "value": "" },
              { "field": "email_type", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "url",
            "target_field": "code_leaks",
            "target_kind": "intel",
            "transform": "trim",
            "when": [
              { "field": "url", "op": "exists", "value": "" },
              { "field": "keyword", "op": "exists", "value": "" },
              { "field": "source", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.related_brands",
            "target_field": "subsidiaries",
            "transform": "trim",
            "when": [
              { "field": "msg.related_brands", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.related_enterprises",
            "target_field": "subsidiaries",
            "transform": "trim",
            "when": [
              { "field": "msg.related_enterprises", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.name_before",
            "target_field": "aliases",
            "transform": "trim",
            "when": [
              { "field": "msg.name_before", "op": "exists", "value": "" },
              { "field": "name_cn", "op": "exists", "value": "" }
            ]
          },
          {
            "path": "$..data[*]",
            "source_field": "msg.mx_list",
            "target_field": "mail_mx",
            "target_kind": "intel",
            "transform": "trim",
            "when": [
              { "field": "msg.mx_list", "op": "exists", "value": "" },
              { "field": "domain", "op": "exists", "value": "" }
            ]
          }
        ]
      }
    }
  }
}
