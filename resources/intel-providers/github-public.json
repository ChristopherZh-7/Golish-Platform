{
  "tool": {
    "id": "github-public",
    "name": "GitHub Public Repository Search",
    "description": "Fixed-destination, read-only GitHub repository discovery for a frozen company or brand pivot.",
    "executable": "",
    "runtime": "native",
    "launchMode": "cli",
    "category": "recon",
    "subcategory": "osint",
    "tags": ["recon", "osint", "code", "public-source", "no-credential"],
    "pentestPhase": ["recon"],
    "tier": "recommended",
    "asset_intel": {
      "enabled": true,
      "provider_id": "github-public",
      "display_name": "GitHub Public Repository Search",
      "capabilities": ["code", "domains"],
      "auto": {"default": true, "priority": 55},
      "runtime": {
        "kind": "http_json",
        "requests": [
          {
            "id": "repository_search",
            "method": "GET",
            "url": "https://api.github.com/search/repositories?q={{company_name}}&per_page=50",
            "headers": {
              "Accept": "application/vnd.github+json",
              "User-Agent": "Golish-Target-Intel"
            },
            "timeout_secs": 30,
            "applicable_pivot_kinds": ["company_name", "brand"],
            "wire_query_type": "repository",
            "adapter_version": "github_public_search.v1",
            "literal_encoder": "url_query_component.v1"
          },
          {
            "id": "organization_repositories",
            "method": "GET",
            "url": "https://api.github.com/search/repositories?q=org%3A{{company_name}}&per_page=100",
            "headers": {
              "Accept": "application/vnd.github+json",
              "User-Agent": "Golish-Target-Intel"
            },
            "timeout_secs": 30,
            "applicable_pivot_kinds": ["github_org"],
            "wire_query_type": "github_org",
            "adapter_version": "github_public_search.v1",
            "literal_encoder": "url_query_component.v1"
          },
          {
            "id": "exact_repository",
            "method": "GET",
            "url": "https://api.github.com/search/repositories?q=repo%3A{{company_name}}&per_page=10",
            "headers": {
              "Accept": "application/vnd.github+json",
              "User-Agent": "Golish-Target-Intel"
            },
            "timeout_secs": 30,
            "applicable_pivot_kinds": ["repository"],
            "wire_query_type": "repository",
            "adapter_version": "github_public_search.v1",
            "literal_encoder": "url_query_component.v1"
          }
        ]
      },
      "normalize": {
        "target": [
          {
            "path": "$..items[*]",
            "label": ["full_name"],
            "value": ["homepage"],
            "confidence": 0.76,
            "when": [{"field": "homepage", "op": "exists", "value": ""}]
          }
        ],
        "profile_fields": [
          {
            "path": "$..items[*]",
            "source_field": "full_name",
            "target_field": "code_repositories",
            "target_kind": "intel",
            "transform": "trim",
            "when": [{"field": "full_name", "op": "exists", "value": ""}]
          },
          {
            "path": "$..items[*]",
            "source_field": "owner.login",
            "target_field": "github_orgs",
            "transform": "trim",
            "when": [{"field": "owner.login", "op": "exists", "value": ""}]
          }
        ]
      }
    }
  }
}
