{
  "tool": {
    "id": "fofa",
    "name": "FOFA（鹰图）",
    "description": "FOFA cyberspace mapping provider exposed to Asset Intel via the native golish-intel-providers registry. Searches the org's surface (domains/IPs/services) and enriches the organization profile.",
    "executable": "",
    "runtime": "native",
    "launchMode": "cli",
    "category": "recon",
    "subcategory": "osint",
    "tags": ["recon", "osint", "asm", "native-provider", "credential-required"],
    "pentestPhase": ["recon"],
    "tier": "recommended",
    "asset_intel": {
      "enabled": true,
      "provider_id": "fofa",
      "display_name": "FOFA（鹰图）",
      "capabilities": ["domains", "ips", "services"],
      "requires_integration": { "tool_id": "fofa", "group_ids": ["default"] },
      "auto": { "default": true, "priority": 70 },
      "runtime": {
        "kind": "native_provider",
        "provider_id": "fofa",
        "queries": [
          { "query_type": "site", "template": "org=\"{{company_name}}\"", "applicable_pivot_kinds": ["company_name", "brand"], "wire_query_type": "org", "adapter_version": "semantic_literal.v1", "literal_encoder": "fofa_quoted_literal.v1" },
          { "query_type": "cert", "template": "cert=\"{{company_name}}\"", "applicable_pivot_kinds": ["certificate"], "wire_query_type": "cert", "adapter_version": "semantic_literal.v1", "literal_encoder": "fofa_quoted_literal.v1" },
          { "query_type": "domain", "template": "{{domain}}", "applicable_pivot_kinds": ["domain", "hostname"], "wire_query_type": "domain", "adapter_version": "semantic_literal.v1", "literal_encoder": "fofa_quoted_literal.v1" }
        ]
      }
    }
  }
}
