{
  "tool": {
    "category": "recon",
    "description": "Map a domain, IP, org name or ASN to its ASN and netblock (CIDR) ranges using public RIR data (ProjectDiscovery). Zero-touch on the target — a passive target_intel (recon/asn) technique.",
    "executable": "asnmap/asnmap",
    "id": "asnmap",
    "install": {
      "linux": {
        "method": "github",
        "source": "projectdiscovery/asnmap"
      },
      "method": "github",
      "source": "projectdiscovery/asnmap",
      "windows": {
        "method": "github",
        "source": "projectdiscovery/asnmap"
      }
    },
    "launchMode": "cli",
    "name": "asnmap",
    "output": {
      "db_action": "target_add",
      "detect": "asnmap|\\bAS\\d+\\b|/\\d{1,2}$",
      "format": "text",
      "patterns": [
        {
          "fields": {
            "value": "$1"
          },
          "regex": "^([0-9]{1,3}(?:\\.[0-9]{1,3}){3}/[0-9]{1,2})$",
          "type": "cidr"
        }
      ],
      "produces": [
        "cidr",
        "ip"
      ]
    },
    "params": [
      {
        "description": "Domain to resolve to ASN/netblocks",
        "flag": "-d",
        "label": "Domain",
        "placeholder": "target.com",
        "type": "string"
      },
      {
        "description": "IP address to resolve to ASN/netblocks",
        "flag": "-i",
        "label": "IP",
        "placeholder": "1.2.3.4",
        "type": "string"
      },
      {
        "description": "ASN to resolve to its netblocks",
        "flag": "-a",
        "label": "ASN",
        "placeholder": "AS14421",
        "type": "string"
      },
      {
        "description": "Organization name to resolve to ASNs",
        "flag": "-org",
        "label": "Org",
        "placeholder": "PINGAN",
        "type": "string"
      },
      {
        "description": "Write JSON lines with ASN/CIDR metadata",
        "flag": "-j",
        "label": "JSON Output",
        "type": "boolean"
      },
      {
        "description": "Save ranges to a file",
        "flag": "-o",
        "label": "Output File",
        "placeholder": "ranges.txt",
        "type": "string"
      },
      {
        "description": "Show only results in output",
        "flag": "-silent",
        "label": "Silent",
        "type": "boolean"
      }
    ],
    "pentestPhase": [
      "recon"
    ],
    "runtime": "native",
    "skills": [
      {
        "args": "-d {{domain}} -silent",
        "description": "Resolve a domain to its ASN and CIDR ranges",
        "id": "asn-from-domain",
        "name": "ASN/netblocks from domain",
        "tags": [
          "passive",
          "asn",
          "fast"
        ]
      },
      {
        "args": "-i {{ip}} -silent",
        "description": "Resolve an IP to its owning ASN and CIDR ranges",
        "id": "asn-from-ip",
        "name": "ASN/netblocks from IP",
        "tags": [
          "passive",
          "asn"
        ]
      }
    ],
    "subcategory": "asn",
    "tags": [
      "recon",
      "asn",
      "netblock",
      "cidr",
      "passive"
    ],
    "tier": "recommended",
    "updateInfo": {
      "lastUpdated": "2026-06-16",
      "version": "v1.1.1"
    }
  }
}