{
  "tool": {
    "id": "burpsuite-community",
    "name": "burpsuite-community",
    "description": "Industry-standard Web vulnerability scanner & intercepting proxy (Community Edition - free, no active scanner)",
    "executable": "burpsuite",
    "runtime": "java",
    "runtimeVersion": "17",
    "launchMode": "gui",
    "category": "web",
    "subcategory": "proxy",
    "tier": "essential",
    "tags": ["web", "proxy", "intercept", "fuzzer"],
    "install": {
      "method": "homebrew-cask",
      "source": "burp-suite"
    },
    "params": [
      {
        "label": "Project File",
        "flag": "--project-file=",
        "type": "string",
        "description": "Open / create project file (auto-save mode)",
        "placeholder": "engagement.burp"
      },
      {
        "label": "Config File",
        "flag": "--config-file=",
        "type": "string",
        "description": "User options config (json)",
        "placeholder": "user-options.json"
      },
      {
        "label": "User Config",
        "flag": "--user-config-file=",
        "type": "string",
        "description": "Per-project user options",
        "placeholder": "proj-config.json"
      },
      {
        "label": "Disable Update Check",
        "flag": "--disable-update-check",
        "type": "boolean",
        "description": "Skip update check on launch"
      },
      {
        "label": "Use Default Project",
        "flag": "--use-defaults",
        "type": "boolean",
        "description": "Skip dialog and start with defaults"
      },
      {
        "label": "Diagnostics",
        "flag": "--diagnostics",
        "type": "boolean",
        "description": "Print diagnostic info"
      }
    ],
    "skills": [
      {
        "id": "default-launch",
        "name": "Default launch",
        "description": "Start Burp normally",
        "args": "",
        "tags": ["interactive"]
      },
      {
        "id": "skip-startup",
        "name": "Skip dialog (use defaults)",
        "description": "Open immediately with default temp project",
        "args": "--use-defaults",
        "tags": ["fast"]
      },
      {
        "id": "open-project",
        "name": "Open existing project",
        "description": "Resume an engagement",
        "args": "--project-file={{project_file}}",
        "tags": ["project"]
      },
      {
        "id": "headless-extender",
        "name": "Headless via project + config",
        "description": "Run with project + user-config (good for Extender bots)",
        "args": "--project-file={{project_file}} --user-config-file={{config_file}}",
        "tags": ["automation"]
      }
    ],
    "output": {
      "format": "text",
      "produces": ["info"],
      "detect": "Burp Suite|PortSwigger",
      "patterns": []
    }
  }
}
