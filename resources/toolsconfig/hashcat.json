{
  "tool": {
    "id": "hashcat",
    "name": "hashcat",
    "description": "World's fastest GPU-accelerated password recovery tool (200+ hash modes)",
    "descriptionI18n": { "zh": "号称全球最快的 GPU 加速密码恢复工具(200+ 种哈希模式)" },
    "executable": "hashcat",
    "runtime": "native",
    "launchMode": "cli",
    "category": "brute",
    "subcategory": "offline",
    "tier": "optional",
    "tags": ["brute", "password", "hash", "gpu", "offline"],
    "tagsI18n": { "zh": ["爆破", "密码", "哈希", "GPU", "离线"] },
    "install": {
      "method": "homebrew",
      "source": "hashcat",
      "windows": { "method": "github", "source": "hashcat/hashcat" },
      "linux": { "method": "github", "source": "hashcat/hashcat" }
    },
    "params": [
      {
        "label": "Hash File",
        "labelI18n": { "zh": "哈希文件" },
        "flag": "",
        "type": "string",
        "required": true,
        "description": "Path to hashes file or single hash string",
        "descriptionI18n": { "zh": "哈希文件路径或单个哈希字符串" },
        "placeholder": "hashes.txt"
      },
      {
        "label": "Hash Mode",
        "labelI18n": { "zh": "哈希模式" },
        "flag": "-m",
        "type": "select",
        "required": true,
        "description": "Hash type number (run --help for full list)",
        "descriptionI18n": { "zh": "哈希类型编号(完整列表见 --help)" },
        "options": [
          { "value": "0", "label": "0 - MD5", "labelI18n": { "zh": "0 - MD5" } },
          { "value": "100", "label": "100 - SHA1", "labelI18n": { "zh": "100 - SHA1" } },
          { "value": "1400", "label": "1400 - SHA256", "labelI18n": { "zh": "1400 - SHA256" } },
          { "value": "1700", "label": "1700 - SHA512", "labelI18n": { "zh": "1700 - SHA512" } },
          { "value": "1000", "label": "1000 - NTLM", "labelI18n": { "zh": "1000 - NTLM" } },
          { "value": "3000", "label": "3000 - LM", "labelI18n": { "zh": "3000 - LM" } },
          { "value": "5500", "label": "5500 - NetNTLMv1", "labelI18n": { "zh": "5500 - NetNTLMv1" } },
          { "value": "5600", "label": "5600 - NetNTLMv2", "labelI18n": { "zh": "5600 - NetNTLMv2" } },
          { "value": "13100", "label": "13100 - Kerberos 5 TGS-REP (Kerberoast)", "labelI18n": { "zh": "13100 - Kerberos 5 TGS-REP(Kerberoast)" } },
          { "value": "18200", "label": "18200 - Kerberos 5 AS-REP (AS-REP roast)", "labelI18n": { "zh": "18200 - Kerberos 5 AS-REP(AS-REP Roast)" } },
          { "value": "500", "label": "500 - md5crypt", "labelI18n": { "zh": "500 - md5crypt" } },
          { "value": "1800", "label": "1800 - sha512crypt", "labelI18n": { "zh": "1800 - sha512crypt" } },
          { "value": "3200", "label": "3200 - bcrypt", "labelI18n": { "zh": "3200 - bcrypt" } },
          { "value": "22000", "label": "22000 - WPA-PBKDF2-PMKID+EAPOL", "labelI18n": { "zh": "22000 - WPA-PBKDF2-PMKID+EAPOL" } },
          { "value": "13400", "label": "13400 - KeePass 1/2", "labelI18n": { "zh": "13400 - KeePass 1/2" } },
          { "value": "9600", "label": "9600 - MS Office 2013", "labelI18n": { "zh": "9600 - MS Office 2013" } },
          { "value": "17200", "label": "17200 - PKZIP", "labelI18n": { "zh": "17200 - PKZIP" } }
        ]
      },
      {
        "label": "Attack Mode",
        "labelI18n": { "zh": "攻击模式" },
        "flag": "-a",
        "type": "select",
        "required": true,
        "description": "Attack mode",
        "descriptionI18n": { "zh": "攻击模式" },
        "default": "0",
        "options": [
          { "value": "0", "label": "0 - Straight (dict)", "labelI18n": { "zh": "0 - 直接字典攻击" } },
          { "value": "1", "label": "1 - Combination (2 dicts)", "labelI18n": { "zh": "1 - 字典组合(双字典)" } },
          { "value": "3", "label": "3 - Brute / Mask", "labelI18n": { "zh": "3 - 暴力/掩码" } },
          { "value": "6", "label": "6 - Hybrid Wordlist + Mask", "labelI18n": { "zh": "6 - 字典 + 掩码" } },
          { "value": "7", "label": "7 - Hybrid Mask + Wordlist", "labelI18n": { "zh": "7 - 掩码 + 字典" } },
          { "value": "9", "label": "9 - Association", "labelI18n": { "zh": "9 - 关联攻击" } }
        ]
      },
      {
        "label": "Wordlist",
        "labelI18n": { "zh": "字典" },
        "flag": "",
        "type": "string",
        "description": "Wordlist file path (positional after hash file)",
        "descriptionI18n": { "zh": "字典文件路径(位于哈希文件之后)" },
        "placeholder": "/usr/share/wordlists/rockyou.txt"
      },
      {
        "label": "Rules",
        "labelI18n": { "zh": "规则文件" },
        "flag": "-r",
        "type": "string",
        "description": "Rules file (e.g. best64.rule, OneRuleToRuleThemAll.rule)",
        "descriptionI18n": { "zh": "规则文件(如 best64.rule、OneRuleToRuleThemAll.rule)" },
        "placeholder": "rules/best64.rule"
      },
      {
        "label": "Mask",
        "labelI18n": { "zh": "掩码" },
        "flag": "",
        "type": "string",
        "description": "Mask pattern for -a 3 (e.g. ?u?l?l?l?l?d?d)",
        "descriptionI18n": { "zh": "用于 -a 3 的掩码模式(如 ?u?l?l?l?l?d?d)" },
        "placeholder": "?l?l?l?l?l?l?d?d"
      },
      {
        "label": "Workload",
        "labelI18n": { "zh": "负载等级" },
        "flag": "-w",
        "type": "select",
        "description": "Workload profile (1=low, 4=insane)",
        "descriptionI18n": { "zh": "负载等级(1=低，4=极速)" },
        "default": "3",
        "options": [
          { "value": "1", "label": "1 - Low (idle)", "labelI18n": { "zh": "1 - 低(空闲态)" } },
          { "value": "2", "label": "2 - Default", "labelI18n": { "zh": "2 - 默认" } },
          { "value": "3", "label": "3 - High", "labelI18n": { "zh": "3 - 高" } },
          { "value": "4", "label": "4 - Insane (full GPU)", "labelI18n": { "zh": "4 - 极速(GPU 全速)" } }
        ]
      },
      {
        "label": "Optimized Kernels",
        "labelI18n": { "zh": "优化内核" },
        "flag": "-O",
        "type": "boolean",
        "description": "Use optimized kernels (limit pwd len, much faster)",
        "descriptionI18n": { "zh": "使用优化内核(限制密码长度，速度更快)" }
      },
      {
        "label": "Force",
        "labelI18n": { "zh": "强制" },
        "flag": "--force",
        "type": "boolean",
        "description": "Ignore warnings",
        "descriptionI18n": { "zh": "忽略警告" }
      },
      {
        "label": "Show Cracked",
        "labelI18n": { "zh": "显示已破解" },
        "flag": "--show",
        "type": "boolean",
        "description": "Show only already-cracked hashes",
        "descriptionI18n": { "zh": "仅显示已破解的哈希" }
      },
      {
        "label": "Restore Session",
        "labelI18n": { "zh": "恢复会话" },
        "flag": "--restore",
        "type": "boolean",
        "description": "Restore previous session",
        "descriptionI18n": { "zh": "恢复之前的会话" }
      },
      {
        "label": "Session Name",
        "labelI18n": { "zh": "会话名" },
        "flag": "--session=",
        "type": "string",
        "description": "Save session with this name",
        "descriptionI18n": { "zh": "以该名字保存会话" },
        "placeholder": "myjob"
      },
      {
        "label": "Output File",
        "labelI18n": { "zh": "输出文件" },
        "flag": "-o",
        "type": "string",
        "description": "Output cracked passwords file",
        "descriptionI18n": { "zh": "已破解密码的输出文件" },
        "placeholder": "cracked.txt"
      },
      {
        "label": "Status Update",
        "labelI18n": { "zh": "状态更新" },
        "flag": "--status",
        "type": "boolean",
        "description": "Print live status updates",
        "descriptionI18n": { "zh": "实时打印状态" }
      },
      {
        "label": "Status Interval",
        "labelI18n": { "zh": "状态间隔(秒)" },
        "flag": "--status-timer=",
        "type": "string",
        "description": "Update interval in seconds",
        "descriptionI18n": { "zh": "状态更新间隔(秒)" },
        "default": "10"
      },
      {
        "label": "Devices",
        "labelI18n": { "zh": "OpenCL 设备" },
        "flag": "-d",
        "type": "string",
        "description": "OpenCL devices to use (comma list, e.g. 1,2)",
        "descriptionI18n": { "zh": "要使用的 OpenCL 设备(逗号分隔，如 1,2)" },
        "placeholder": "1"
      }
    ],
    "skills": [
      {
        "id": "md5-rockyou",
        "name": "MD5 + rockyou",
        "nameI18n": { "zh": "MD5 + rockyou" },
        "description": "Straight dict attack on MD5 hashes",
        "descriptionI18n": { "zh": "对 MD5 哈希做直接字典攻击" },
        "args": "-m 0 -a 0 {{hashes}} /usr/share/wordlists/rockyou.txt",
        "tags": ["md5", "dict"],
        "tagsI18n": { "zh": ["MD5", "字典"] }
      },
      {
        "id": "ntlm-best64",
        "name": "NTLM + best64 rules",
        "nameI18n": { "zh": "NTLM + best64 规则" },
        "description": "NTLM crack with mangling",
        "descriptionI18n": { "zh": "带变形规则的 NTLM 破解" },
        "args": "-m 1000 -a 0 {{hashes}} /usr/share/wordlists/rockyou.txt -r rules/best64.rule",
        "tags": ["ntlm", "windows"],
        "tagsI18n": { "zh": ["NTLM", "Windows"] }
      },
      {
        "id": "wpa-pmkid",
        "name": "WPA PMKID crack",
        "nameI18n": { "zh": "WPA PMKID 破解" },
        "description": "Crack WPA from PMKID file (hcxdumptool output)",
        "descriptionI18n": { "zh": "用 PMKID 文件破解 WPA(hcxdumptool 输出)" },
        "args": "-m 22000 -a 0 {{hashes}} /usr/share/wordlists/rockyou.txt",
        "tags": ["wpa", "wifi"],
        "tagsI18n": { "zh": ["WPA", "Wi-Fi"] }
      },
      {
        "id": "kerberoast",
        "name": "Kerberoast TGS",
        "nameI18n": { "zh": "Kerberoast TGS 破解" },
        "description": "Crack TGS-REP (Active Directory)",
        "descriptionI18n": { "zh": "破解 TGS-REP(AD 域)" },
        "args": "-m 13100 -a 0 {{hashes}} /usr/share/wordlists/rockyou.txt",
        "tags": ["ad", "kerberos"],
        "tagsI18n": { "zh": ["AD 域", "Kerberos"] }
      },
      {
        "id": "mask-bf",
        "name": "8-char mask brute",
        "nameI18n": { "zh": "8 位掩码爆破" },
        "description": "Pattern-based brute (lower + digits)",
        "descriptionI18n": { "zh": "基于规律的爆破(小写字母 + 数字)" },
        "args": "-m 0 -a 3 {{hashes}} ?l?l?l?l?l?l?d?d",
        "tags": ["mask"],
        "tagsI18n": { "zh": ["掩码"] }
      },
      {
        "id": "hybrid-mask-suffix",
        "name": "Hybrid (dict + mask suffix)",
        "nameI18n": { "zh": "混合(字典 + 掩码后缀)" },
        "description": "Dict word + 4 digits (common pattern)",
        "descriptionI18n": { "zh": "字典单词 + 4 位数字(常见组合)" },
        "args": "-m 0 -a 6 {{hashes}} /usr/share/wordlists/rockyou.txt ?d?d?d?d",
        "tags": ["hybrid"],
        "tagsI18n": { "zh": ["混合"] }
      },
      {
        "id": "show-cracked",
        "name": "Show already cracked",
        "nameI18n": { "zh": "查看已破解" },
        "description": "Display passwords from potfile",
        "descriptionI18n": { "zh": "从 potfile 中显示已破解的密码" },
        "args": "-m {{mode}} --show {{hashes}}",
        "tags": ["report"],
        "tagsI18n": { "zh": ["报告"] }
      }
    ],
    "output": {
      "format": "text",
      "produces": ["credential"],
      "detect": "hashcat|Status\\.+:|Recovered\\.+:",
      "db_action": "credential_add",
      "patterns": [
        {
          "type": "credential",
          "regex": "^([0-9a-fA-F:$\\.\\-/]+):(.+)$",
          "fields": {
            "1": "hash",
            "2": "password"
          }
        }
      ]
    }
  }
}
