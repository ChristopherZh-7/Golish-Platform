{
  "tool": {
    "id": "ssh-audit",
    "pentestPhase": ["vuln_id"],
    "name": "ssh-audit",
    "description": "Observe SSH banners, algorithms and policy on one exact host and port.",
    "executable": "ssh-audit",
    "runtime": "python",
    "runtimeVersion": "3.11",
    "launchMode": "cli",
    "version": "3.9.0",
    "category": "network",
    "subcategory": "ssh",
    "tier": "recommended",
    "tags": ["ssh", "algorithm", "network-observe", "mit"],
    "install": {
      "method": "pip",
      "source": "ssh-audit",
      "macos": {"method": "pip", "source": "ssh-audit"},
      "linux": {"method": "pip", "source": "ssh-audit"},
      "windows": {"method": "pip", "source": "ssh-audit"}
    },
    "params": [
      {"label": "Exact host", "flag": "", "type": "string", "required": true, "description": "One exact authorized SSH host.", "placeholder": "target.example"},
      {"label": "Port", "flag": "-p", "type": "string", "required": true, "default": "22", "description": "Exact authorized SSH port."},
      {"label": "JSON", "flag": "-j", "type": "boolean", "description": "Emit machine-readable JSON."},
      {"label": "Timeout", "flag": "-t", "type": "string", "default": "5", "description": "Bounded connection timeout."}
    ],
    "skills": [
      {"id": "local-help", "name": "Local help smoke", "description": "No-target executable smoke only.", "args": "-h", "tags": ["local", "no-target"]}
    ],
    "output": {"format": "json", "produces": ["ssh_algorithm", "banner", "info"], "patterns": [], "fields": {}, "detect": "ssh-audit|algorithm recommendations"}
  }
}
