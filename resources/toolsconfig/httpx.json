{
  "tool": {
    "id": "httpx",
    "pentestPhase": ["recon", "enum"],
    "name": "httpx",
    "description": "Fast multi-purpose HTTP toolkit (probe, status, title, tech, screenshots)",
    "executable": "httpx",
    "runtime": "native",
    "launchMode": "cli",
    "category": "recon",
    "subcategory": "http",
    "tier": "recommended",
    "tags": ["recon", "http", "probe", "fingerprint"],
    "install": {
      "method": "github",
      "source": "projectdiscovery/httpx",
      "windows": { "method": "github", "source": "projectdiscovery/httpx" },
      "linux": { "method": "github", "source": "projectdiscovery/httpx" }
    },
    "params": [
      {
        "label": "URL",
        "flag": "-u",
        "type": "string",
        "description": "Single target URL or host. For EAS batches prefer -l or stdin so one run covers many hosts.",
        "placeholder": "https://target.com"
      },
      {
        "label": "Targets List",
        "flag": "-l",
        "type": "string",
        "description": "File with hosts (one per line). With pentest_run, use {{input_file}} plus input_lines for batch runs.",
        "placeholder": "{{input_file}}"
      },
      {
        "label": "Ports",
        "flag": "-ports",
        "type": "string",
        "description": "Ports to probe (comma list or range)",
        "placeholder": "80,443,8080,8443"
      },
      {
        "label": "Status Code",
        "flag": "-sc",
        "type": "boolean",
        "description": "Show HTTP status code"
      },
      {
        "label": "Title",
        "flag": "-title",
        "type": "boolean",
        "description": "Show page title"
      },
      {
        "label": "Tech Detect",
        "flag": "-td",
        "type": "boolean",
        "description": "Detect technologies (Wappalyzer-like)"
      },
      {
        "label": "Web Server",
        "flag": "-server",
        "type": "boolean",
        "description": "Show Server header"
      },
      {
        "label": "Content Length",
        "flag": "-cl",
        "type": "boolean",
        "description": "Show response content length"
      },
      {
        "label": "Match Status",
        "flag": "-mc",
        "type": "string",
        "description": "Show only these status codes (e.g. 200,301)",
        "placeholder": "200,301"
      },
      {
        "label": "Filter Status",
        "flag": "-fc",
        "type": "string",
        "description": "Hide these status codes",
        "placeholder": "404,500"
      },
      {
        "label": "Threads",
        "flag": "-t",
        "type": "string",
        "description": "Concurrent threads",
        "default": "50"
      },
      {
        "label": "Rate Limit",
        "flag": "-rl",
        "type": "string",
        "description": "Max requests per second",
        "placeholder": "150"
      },
      {
        "label": "Timeout",
        "flag": "-timeout",
        "type": "string",
        "description": "Request timeout in seconds",
        "default": "10"
      },
      {
        "label": "Follow Redirects",
        "flag": "-fr",
        "type": "boolean",
        "description": "Follow HTTP 3xx redirects"
      },
      {
        "label": "Probe All IPs",
        "flag": "-probe",
        "type": "boolean",
        "description": "Probe all returned IPs (resolve)"
      },
      {
        "label": "Screenshot",
        "flag": "-ss",
        "type": "boolean",
        "description": "Save screenshots (requires headless browser)"
      },
      {
        "label": "Output File",
        "flag": "-o",
        "type": "string",
        "description": "Save results to file",
        "placeholder": "live.txt"
      },
      {
        "label": "JSONL Output",
        "flag": "-json",
        "type": "boolean",
        "description": "Output JSONL with rich metadata"
      },
      {
        "label": "Silent",
        "flag": "-silent",
        "type": "boolean",
        "description": "Show only URLs"
      }
    ],
    "skills": [
      {
        "id": "alive-only",
        "name": "Alive URLs only",
        "description": "Probe and output only live URLs",
        "args": "-l {{input_file}} -json -silent -o httpx.jsonl",
        "tags": ["probe", "fast", "bulk"]
      },
      {
        "id": "rich-info",
        "name": "Status + title + tech",
        "description": "Live URL with status, title, tech, server",
        "args": "-l {{input_file}} -json -sc -title -td -server",
        "tags": ["recon", "bulk"]
      },
      {
        "id": "json-pipeline",
        "name": "JSONL for pipeline",
        "description": "Probe and output JSONL with full metadata",
        "args": "-l {{input_file}} -json -sc -title -td -server -o httpx.jsonl",
        "tags": ["pipeline", "bulk"]
      },
      {
        "id": "screenshots",
        "name": "Screenshots all live hosts",
        "description": "Probe + take screenshots into output/ dir",
        "args": "-l {{input_file}} -ss -silent",
        "tags": ["recon", "visual", "bulk"]
      },
      {
        "id": "common-ports",
        "name": "Common web ports probe",
        "description": "Probe alternate web ports beyond 80/443",
        "args": "-l {{input_file}} -ports 80,443,8080,8443,8000,8888,9000 -json -sc -title -td -server",
        "tags": ["ports", "bulk"]
      }
    ],
    "output": {
      "format": "json_lines",
      "produces": ["url", "host", "technology"],
      "fields": {
        "url": "url",
        "status_code": "status_code",
        "title": "title",
        "webserver": "webserver",
        "technologies": "tech",
        "host": "host",
        "ip": "a[0]",
        "port": "port",
        "scheme": "scheme",
        "content_type": "content_type"
      },
      "detect": "httpx|\\{\"url\"|^https?://",
      "db_action": "target_update_recon",
      "patterns": [
        {
          "type": "url",
          "regex": "^(https?://[^\\s]+)\\s+\\[(\\d+)\\](?:\\s+\\[([^\\]]*)\\])?",
          "fields": {
            "url": "$1",
            "status": "$2",
            "title": "$3"
          }
        }
      ]
    }
  }
}
