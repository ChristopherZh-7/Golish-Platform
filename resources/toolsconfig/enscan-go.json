              ],
              "target_field": "social_accounts",
              "transform": "trim"
            }
          ],
          "target": [
            {
              "confidence": 0.78,
              "label": "domain",
              "path": "$..icp[*]",
              "value": "domain"
            },
            {
              "confidence": 0.68,
              "label": "name",
              "path": "$..app[*]",
              "value": [
                "link",
                "app_url",
                "name"
              ]
            },
            {
              "confidence": 0.68,
              "label": "name",
              "path": "$..wx_app[*]",
              "value": [
                "app_id",
                "name"
              ]
            },
            {
              "confidence": 0.62,
              "label": "name",
              "path": "$..wechat[*]",
              "value": [
                "wechat_id",
                "id",
                "name"
              ]
            },
            {
              "confidence": 0.62,
              "label": "name",
              "path": "$..weibo[*]",
              "value": [
                "weibo_id",
                "id",
                "name"
              ]
            }
          ]
        },
        "provider_id": "enscan-go-enrichment",
        "requires_integration": {
          "group_ids": [
            "aqc"
          ],
          "tool_id": "enscan-go"
        },
        "runtime": {
          "artifact_globs": [
            "**/*.json"
          ],
          "kind": "cli_json",
          "skill_id": "company-enrichment-json",
          "timeout_secs": 180
        }
      }
    ],
    "category": "recon",
    "description": "Chinese enterprise intelligence collector for company trees, ICP records, apps, mini-programs, social accounts, investments, branches, and public recruitment data. Uses user-provided cookies/tokens for sources such as AQC, TYC, KC, RB, and MIIT.",
    "executable": "ENScan_GO/enscan-v2.0.6-darwin-amd64",
    "id": "enscan-go",
    "install": {
      "linux": {
        "method": "github",
        "source": "ChristopherZh-7/ENScan_GO"
      },
      "method": "github",
      "source": "ChristopherZh-7/ENScan_GO",
      "windows": {
        "method": "github",
        "source": "ChristopherZh-7/ENScan_GO"
      }
    },
    "integration": {
      "category": "enterprise-intel",
      "description": "Cookies for the five upstream enterprise-intel sources ENScan_GO talks to. Cookies typically expire after 1-7 days; refresh when scans start returning empty.",
      "display_name": "ENScan_GO 企业情报",
      "groups": [
        {
          "capture": {
            "instructions": "登录爱企查账号后（如百度要求手机二次验证，请完成绿码/短信验证直到跳回 aiqicha.baidu.com 首页 或 百度企业 qiye.baidu.com/usercenter 个人中心），Golish 自动提取 .baidu.com 域所有 cookie 拼成完整 Cookie header 写入 cookies.aqc 字段。capture 引擎会等到 BDUSS 出现才算登录成功（避免抓未登录态 cookie）。",
            "login_url": "https://aiqicha.baidu.com/",
            "rules": [
              {
                "domain": ".baidu.com",
                "fmt": "{name}={value}",
                "names": [],
                "required": true,
                "required_names": [
                  "BDUSS"
                ],
                "sep": "; ",
                "target_field": "cookies.aqc",
                "type": "cookie_joined"
              }
            ],
            "success_url_pattern": "(aiqicha|qiye)\\.baidu\\.com/($|\\?|#|home\\b|usercenter\\b|user/|personalcenter\\b)",
            "timeout_secs": 300
          },
          "description": "Log in to aiqicha.baidu.com (Baidu may redirect post-login to qiye.baidu.com — both domains are recognised), then click the ⚡ button to harvest the full baidu.com Cookie header automatically (BDUSS alone is rejected by AQC's safety wall — the engine joins every cookie on .baidu.com into a `name=value; name=value` header). Manual paste of the same header also works.",
          "fields": [
            {
              "key": "cookies.aqc",
              "label": "Cookie",
              "placeholder": "BAIDUID=...; BDUSS=...; PSTM=...; ...",
              "required": true,
              "rows": 4,
              "type": "secret_textarea"
            }
          ],
          "help_url": "https://github.com/ChristopherZh-7/ENScan_GO#aqc",
          "id": "aqc",
          "name": "爱企查 (AQC)",
          "test": {
            "cmd": "{{exec}} -n 小米 -type aqc -field icp",
            "fail_regex": "(?i)cookie\\s*expired|auth\\s*failed|安全验证",
            "kind": "exec",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "timeout_secs": 60
          }
        },
        {
          "capture": {
            "instructions": "登录天眼查后，Golish 会打开搜索探针页以确认登录态，并自动提取完整 Cookie、TYCID cookie 和 auth_token cookie，分别写入 cookies.tyc / tyc.tycid / tyc.auth_token。",
            "login_url": "https://www.tianyancha.com/search?key=%E5%B0%8F%E7%B1%B3",
            "rules": [
              {
                "domain": ".tianyancha.com",
                "fmt": "{name}={value}",
                "names": [],
                "required": true,
                "sep": "; ",
                "target_field": "cookies.tyc",
                "type": "cookie_joined"
              },
              {
                "domain": ".tianyancha.com",
                "name": "TYCID",
                "required": true,
                "target_field": "tyc.tycid",
                "type": "cookie"
              },
              {
                "domain": ".tianyancha.com",
                "name": "auth_token",
                "required": true,
                "target_field": "tyc.auth_token",
                "type": "cookie"
              }
            ],
            "success_url_pattern": "tianyancha\\.com",
            "timeout_secs": 300
          },
          "description": "TYC needs three values together: full Cookie, the TYCID cookie, and the auth_token cookie. All three can be captured from a logged-in tianyancha.com session.",
          "fields": [
            {
              "key": "cookies.tyc",
              "label": "Cookie",
              "required": true,
              "rows": 4,
              "type": "secret_textarea"
            },
            {
              "key": "tyc.tycid",
              "label": "tycid",
              "placeholder": "TYCID cookie value",
              "required": true,
              "type": "secret_text"
            },
            {
              "key": "tyc.auth_token",
              "label": "auth_token",
              "placeholder": "auth_token cookie value",
              "required": true,
              "type": "secret_text"
            }
          ],
          "help_url": "https://github.com/ChristopherZh-7/ENScan_GO#tyc",
          "id": "tyc",
          "name": "天眼查 (TYC)",
          "test": {
            "cmd": "{{exec}} -n 小米 -type tyc -field icp",
            "fail_regex": "(?i)cookie\\s*expired|auth\\s*failed|安全验证",
            "kind": "exec",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "timeout_secs": 60
          }
        },
        {
          "capture": {
            "instructions": "登录七麦数据后，Golish 会等到 USERINFO 和 aso_ucenter 这两个登录态 cookie 出现，再自动提取 qimai.cn 相关 Cookie 并写入 cookies.qimai 字段。若只看到 synct/syncd/qm_check/PHPSESSID，说明还没真正登录成功，窗口会继续等待。",
            "login_url": "https://www.qimai.cn/",
            "rules": [
              {
                "domain": ".qimai.cn",
                "fmt": "{name}={value}",
                "min_count": 2,
                "names": [],
                "required": true,
                "required_names": [
                  "USERINFO",
                  "aso_ucenter"
                ],
                "sep": "; ",
                "target_field": "cookies.qimai",
                "type": "cookie_joined"
              }
            ],
            "success_url_pattern": "qimai\\.cn",
            "timeout_secs": 300
          },
          "description": "ENScan_GO v2.0.6 maps -type kc to the qimai.cn enterprise data source (legacy 快查/kuaicha alias). Cookie copied from a logged-in qimai.cn session.",
          "fields": [
            {
              "key": "cookies.qimai",
              "label": "Cookie",
              "required": true,
              "rows": 4,
              "type": "secret_textarea"
            }
          ],
          "id": "kc",
          "name": "七麦数据 (Qimai)",
          "test": {
            "cmd": "{{exec}} -n 小米 -type kc -field icp",
            "fail_regex": "(?i)cookie\\s*expired|auth\\s*failed|安全验证",
            "kind": "exec",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "timeout_secs": 60
          }
        },
        {
          "capture": {
            "instructions": "登录风鸟 RiskBird 后，Golish 会自动提取 riskbird.com 相关 Cookie 并写入 cookies.risk_bird 字段。",
            "login_url": "https://www.riskbird.com/",
            "rules": [
              {
                "domain": ".riskbird.com",
                "fmt": "{name}={value}",
                "min_count": 3,
                "names": [],
                "required": true,
                "sep": "; ",
                "target_field": "cookies.risk_bird",
                "type": "cookie_joined"
              }
            ],
            "success_url_pattern": "riskbird\\.com",
            "timeout_secs": 300
          },
          "description": "Cookie copied from a logged-in riskbird.com session.",
          "fields": [
            {
              "key": "cookies.risk_bird",
              "label": "Cookie",
              "required": true,
              "rows": 4,
              "type": "secret_textarea"
            }
          ],
          "id": "rb",
          "name": "风鸟 (RiskBird)",
          "test": {
            "cmd": "{{exec}} -n 小米 -type rb -field icp",
            "fail_regex": "(?i)cookie\\s*expired|auth\\s*failed|安全验证",
            "kind": "exec",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "timeout_secs": 60
          }
        },
        {
          "description": "Token + Sign captured from the MIIT ICP backend (beian.miit.gov.cn).",
          "fields": [
            {
              "key": "miit.token",
              "label": "Token",
              "required": true,
              "type": "secret_text"
            },
            {
              "key": "miit.sign",
              "label": "Sign",
              "required": true,
              "type": "secret_text"
            }
          ],
          "id": "miit",
          "name": "MIIT ICP plugin",
          "test": {
            "cmd": "{{exec}} -n 小米 -type miit -field icp",
            "fail_regex": "(?i)token\\s*expired|sign\\s*invalid|auth\\s*failed",
            "kind": "exec",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "timeout_secs": 30
          }
        }
      ],
      "help_url": "https://github.com/ChristopherZh-7/ENScan_GO#config",
      "storage": {
        "external_file": {
          "backup_on_write": true,
          "defaults": {
            "version": 0.7
          },
          "format": "yaml",
          "path": "{{tools_dir}}/ENScan_GO/config.yaml",
          "preserve_unknown_keys": true
        },
        "type": "external_file"
      }
    },
    "launchMode": "cli",
    "name": "ENScan_GO",
    "output": {
      "detect": "ENScan|enterprise_info|icp|invest|branch|holds",
      "fields": {
        "app.bundle_id": "app_id",
        "app.link": "app_url",
        "app.name": "app_name",
        "branch.name": "subsidiary",
        "copyright.name": "software_copyright",
        "enterprise_info.email": "email",
        "enterprise_info.name": "organization_name",
        "enterprise_info.phone": "contact_phone",
        "enterprise_info.reg_code": "credit_code",
        "holds.name": "subsidiary",
        "holds.scale": "ownership_percent",
        "icp.company_name": "organization_name",
        "icp.domain": "domain",
        "invest.name": "subsidiary",
        "invest.pid": "provider_company_id",
        "invest.scale": "ownership_percent",
        "job.name": "job_title",
        "wechat.name": "social_account_name",
        "wechat.wechat_id": "wechat_id",
        "weibo.name": "social_account_name",
        "wx_app.name": "app_name"
      },
      "format": "json",
      "produces": [
        "organization",
        "domain",
        "business_system",
        "social_account",
        "contact",
        "intel"
      ]
    },
    "params": [
      {
        "description": "Company keyword or full legal name",
        "flag": "-n",
        "label": "Company Name",
        "placeholder": "小米",
        "required": true,
        "type": "string"
      },
      {
        "default": "aqc",
        "description": "Enterprise data source. Requires the matching cookie/token in ENScan config.",
        "flag": "-type",
        "label": "Data Source",
        "options": [
          {
            "label": "爱企查 (AQC)",
            "value": "aqc"
          },
          {
            "label": "天眼查 (TYC)",
            "value": "tyc"
          },
          {
            "label": "快查 (KC)",
            "value": "kc"
          },
          {
            "label": "风鸟 (RiskBird)",
            "value": "rb"
          },
          {
            "label": "MIIT ICP plugin",
            "value": "miit"
          },
          {
            "label": "All supported sources",
            "value": "all"
          }
        ],
        "type": "select"
      },
      {
        "default": "icp,app,wx_app,wechat",
        "description": "Comma-separated fields to collect",
        "flag": "-field",
        "label": "Fields",
        "placeholder": "icp,app,wx_app,wechat",
        "type": "string"
      },
      {
        "description": "Only collect invested companies whose ownership percentage is greater than or equal to this value",
        "flag": "-invest",
        "label": "Minimum Investment Percent",
        "placeholder": "51",
        "type": "string"
      },
      {
        "default": "1",
        "description": "Recursive company relationship depth. Requires -invest.",
        "flag": "-deep",
        "label": "Depth",
        "type": "string"
      },
      {
        "description": "Collect branch companies",
        "flag": "-branch",
        "label": "Include Branches",
        "type": "boolean"
      },
      {
        "description": "Collect holding companies. Some sources may require VIP account.",
        "flag": "-hold",
        "label": "Include Holdings",
        "type": "boolean"
      },
      {
        "description": "Collect supplier information from public tender/report data",
        "flag": "-supplier",
        "label": "Include Suppliers",
        "type": "boolean"
      },
