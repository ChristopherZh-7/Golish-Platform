{
  "tool": {
    "asset_intel_providers": [
      {
        "auto": {
          "default": true,
          "priority": 100
        },
        "capabilities": [
          "subsidiaries"
        ],
        "discovery": {
          "auto_promote": false,
          "dedupe_by": [
            "pid",
            "name"
          ],
          "ownership_field": "scale",
          "promote_when": [
            {
              "field": "scale",
              "op": "gte",
              "value": "51"
            }
          ]
        },
        "display_name": "ENScan_GO",
        "enabled": true,
        "lookup": {
          "enabled": true,
          "normalize": {
            "address": "address",
            "credit_code": "reg_code",
            "default_confidence": 0.68,
            "legal_representative": "legal_person",
            "name": "name",
            "path": "$..enterprise_info[*]",
            "registered_at": "incorporation_date"
          },
          "skill_id": "company-lookup-json",
          "timeout_secs": 60
        },
        "normalize": {
          "organization": [
            {
              "confidence": 0.82,
              "label": "name",
              "path": "$..invest[*]",
              "value": "name"
            },
            {
              "confidence": 0.82,
              "label": "name",
              "path": "$..holds[*]",
              "value": "name"
            },
            {
              "confidence": 0.78,
              "label": "name",
              "path": "$..branch[*]",
              "value": "name"
            }
          ],
          "profile_fields": [
            {
              "path": "$..enterprise_info[*]",
              "source_field": "reg_code",
              "target_field": "credit_code",
              "transform": "trim"
            },
            {
              "path": "$..enterprise_info[*]",
              "source_field": "legal_person",
              "target_field": "legal_representative",
              "target_kind": "intel",
              "transform": "trim"
            },
            {
              "path": "$..enterprise_info[*]",
              "source_field": "address",
              "target_field": "registered_address",
              "target_kind": "intel",
              "transform": "trim"
            },
            {
              "path": "$..enterprise_info[*]",
              "source_field": "incorporation_date",
              "target_field": "registered_at",
              "target_kind": "intel",
              "transform": "trim"
            },
            {
              "path": "$..enterprise_info[*]",
              "source_field": "registered_capital",
              "target_field": "registered_capital",
              "target_kind": "intel",
              "transform": "trim"
            },
            {
              "path": "$..enterprise_info[*]",
              "source_field": "status",
              "target_field": "business_status",
              "target_kind": "intel",
              "transform": "trim"
            },
            {
              "path": "$..enterprise_info[*]",
              "source_field": "pid",
              "target_field": "aqc_pid",
              "target_kind": "intel",
              "transform": "trim"
            },
            {
              "path": "$..enterprise_info[*]",
              "source_field": "email",
              "target_field": "email",
              "target_kind": "contact",
              "transform": "lower",
              "when": [
                {
                  "field": "email",
                  "op": "ne",
                  "value": "-"
                }
              ]
            },
            {
              "path": "$..enterprise_info[*]",
              "source_field": "phone",
              "target_field": "phone",
              "target_kind": "contact",
              "transform": "trim",
              "when": [
                {
                  "field": "phone",
                  "op": "ne",
                  "value": "-"
                }
              ]
            }
          ],
          "target": [
            {
              "confidence": 0.78,
              "label": "domain",
              "path": "$..icp[*]",
              "value": "domain"
            },
            {
              "confidence": 0.68,
              "label": "name",
              "path": "$..app[*]",
              "value": [
                "link",
                "app_url",
                "name"
              ]
            },
            {
              "confidence": 0.68,
              "label": "name",
              "path": "$..wx_app[*]",
              "value": [
                "app_id",
                "name"
              ]
            },
            {
              "confidence": 0.62,
              "label": "name",
              "path": "$..wechat[*]",
              "value": [
                "wechat_id",
                "id",
                "name"
              ]
            },
            {
              "confidence": 0.62,
              "label": "name",
              "path": "$..weibo[*]",
              "value": [
                "weibo_id",
                "id",
                "name"
              ]
            }
          ]
        },
        "provider_id": "enscan-go",
        "requires_integration": {
          "group_ids": [
            "aqc"
          ],
          "tool_id": "enscan-go"
        },
        "runtime": {
          "arg_bindings": {
            "depth": "-deep {{config.depth}}",
            "include_branches": "-branch",
            "min_ownership_percent": "-invest {{config.min_ownership_percent}}"
          },
          "artifact_globs": [
            "**/*.json"
          ],
          "kind": "cli_json",
          "skill_id": "company-default-json",
          "timeout_secs": 180
        }
      },
      {
        "auto": {
          "default": true,
          "priority": 80
        },
        "capabilities": [
          "domains",
          "icp",
          "apps",
          "mini_programs",
