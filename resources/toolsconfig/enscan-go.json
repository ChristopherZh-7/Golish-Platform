            },
            {
              "path": "$..wechat[*]",
              "source_field": [
                "wechat_id",
                "id",
                "name"
              ],
              "target_field": "social_accounts",
              "transform": "trim"
            },
            {
              "path": "$..weibo[*]",
              "source_field": [
