    "params": [
      {
        "description": "Company keyword or full legal name",
        "flag": "-n",
        "label": "Company Name",
        "placeholder": "小米",
        "required": true,
        "type": "string"
      },
      {
        "default": "aqc",
        "description": "Enterprise data source. Requires the matching cookie/token in ENScan config.",
        "flag": "-type",
        "label": "Data Source",
        "options": [
          {
            "label": "爱企查 (AQC)",
            "value": "aqc"
          },
          {
            "label": "天眼查 (TYC)",
            "value": "tyc"
          },
          {
            "label": "快查 (KC)",
            "value": "kc"
          },
          {
