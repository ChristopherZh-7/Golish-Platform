{
  "tool": {
    "category": "recon",
    "description": "Chinese enterprise intelligence collector for company trees, ICP records, apps, mini-programs, social accounts, investments, branches, and public recruitment data. Uses user-provided cookies/tokens for sources such as AQC, TYC, KC, RB, and MIIT.",
    "executable": "ENScan_GO/enscan-v2.0.5-darwin-amd64",
    "id": "enscan-go",
    "integration": {
      "category": "enterprise-intel",
      "display_name": "ENScan_GO 企业情报",
      "description": "Cookies for the five upstream enterprise-intel sources ENScan_GO talks to. Cookies typically expire after 1-7 days; refresh when scans start returning empty.",
      "help_url": "https://github.com/wgpsec/ENScan_GO#config",
      "storage": {
        "type": "external_file",
        "external_file": {
          "path": "{{tools_dir}}/ENScan_GO/config.yaml",
          "format": "yaml",
          "preserve_unknown_keys": true,
          "backup_on_write": true,
          "defaults": {
            "version": 0.7
          }
        }
      },
      "groups": [
        {
          "id": "aqc",
          "name": "爱企查 (AQC)",
          "description": "Log in to aiqicha.baidu.com (Baidu may redirect post-login to qiye.baidu.com — both domains are recognised), then click the ⚡ button to harvest the full baidu.com Cookie header automatically (BDUSS alone is rejected by AQC's safety wall — the engine joins every cookie on .baidu.com into a `name=value; name=value` header). Manual paste of the same header also works.",
          "help_url": "https://github.com/wgpsec/ENScan_GO#aqc",
          "fields": [
            {
              "key": "cookies.aqc",
              "label": "Cookie",
              "type": "secret_textarea",
              "placeholder": "BAIDUID=...; BDUSS=...; PSTM=...; ...",
              "required": true,
              "rows": 4
            }
          ],
          "test": {
            "kind": "exec",
            "cmd": "{{exec}} -n 小米 -type aqc -field icp",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "fail_regex": "(?i)cookie\\s*expired|auth\\s*failed|安全验证",
            "timeout_secs": 60
          },
          "capture": {
            "login_url": "https://aiqicha.baidu.com/",
            "success_url_pattern": "(aiqicha|qiye)\\.baidu\\.com/($|\\?|#|home\\b|usercenter\\b|user/|personalcenter\\b)",
            "timeout_secs": 300,
            "instructions": "登录爱企查账号后（如百度要求手机二次验证，请完成绿码/短信验证直到跳回 aiqicha.baidu.com 首页 或 百度企业 qiye.baidu.com/usercenter 个人中心），Golish 自动提取 .baidu.com 域所有 cookie 拼成完整 Cookie header 写入 cookies.aqc 字段。capture 引擎会等到 BDUSS 出现才算登录成功（避免抓未登录态 cookie）。",
            "rules": [
              {
                "type": "cookie_joined",
                "domain": ".baidu.com",
                "names": [],
                "sep": "; ",
                "fmt": "{name}={value}",
                "target_field": "cookies.aqc",
                "required": true,
                "required_names": ["BDUSS"]
              }
            ]
          }
        },
        {
          "id": "tyc",
          "name": "天眼查 (TYC)",
          "description": "TYC needs three values together: full Cookie, the TYCID cookie, and the auth_token cookie. All three can be captured from a logged-in tianyancha.com session.",
          "help_url": "https://github.com/wgpsec/ENScan_GO#tyc",
          "fields": [
            { "key": "cookies.tyc", "label": "Cookie", "type": "secret_textarea", "required": true, "rows": 4 },
            { "key": "tyc.tycid", "label": "tycid", "type": "secret_text", "required": true, "placeholder": "TYCID cookie value" },
            { "key": "tyc.auth_token", "label": "auth_token", "type": "secret_text", "required": true, "placeholder": "auth_token cookie value" }
          ],
          "test": {
            "kind": "exec",
            "cmd": "{{exec}} -n 小米 -type tyc -field icp",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "fail_regex": "(?i)cookie\\s*expired|auth\\s*failed|安全验证",
            "timeout_secs": 60
          },
          "capture": {
            "login_url": "https://www.tianyancha.com/search?key=%E5%B0%8F%E7%B1%B3",
            "success_url_pattern": "tianyancha\\.com",
            "timeout_secs": 300,
            "instructions": "登录天眼查后，Golish 会打开搜索探针页以确认登录态，并自动提取完整 Cookie、TYCID cookie 和 auth_token cookie，分别写入 cookies.tyc / tyc.tycid / tyc.auth_token。",
            "rules": [
              {
                "type": "cookie_joined",
                "domain": ".tianyancha.com",
                "names": [],
                "sep": "; ",
                "fmt": "{name}={value}",
                "target_field": "cookies.tyc",
                "required": true
              },
              {
                "type": "cookie",
                "domain": ".tianyancha.com",
                "name": "TYCID",
                "target_field": "tyc.tycid",
                "required": true
              },
              {
                "type": "cookie",
                "domain": ".tianyancha.com",
                "name": "auth_token",
                "target_field": "tyc.auth_token",
                "required": true
              }
            ]
          }
        },
        {
          "id": "kc",
          "name": "七麦数据 (Qimai)",
          "description": "ENScan_GO v2.0.5 maps -type kc to the qimai.cn enterprise data source (legacy 快查/kuaicha alias). Cookie copied from a logged-in qimai.cn session.",
          "fields": [
            {
              "key": "cookies.qimai",
              "label": "Cookie",
              "type": "secret_textarea",
              "required": true,
              "rows": 4
            }
          ],
          "test": {
            "kind": "exec",
            "cmd": "{{exec}} -n 小米 -type kc -field icp",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "fail_regex": "(?i)cookie\\s*expired|auth\\s*failed|安全验证",
            "timeout_secs": 60
          },
          "capture": {
            "login_url": "https://www.qimai.cn/",
            "success_url_pattern": "qimai\\.cn",
            "timeout_secs": 300,
            "instructions": "登录七麦数据后，Golish 会等到 USERINFO 和 aso_ucenter 这两个登录态 cookie 出现，再自动提取 qimai.cn 相关 Cookie 并写入 cookies.qimai 字段。若只看到 synct/syncd/qm_check/PHPSESSID，说明还没真正登录成功，窗口会继续等待。",
            "rules": [
              {
                "type": "cookie_joined",
                "domain": ".qimai.cn",
                "names": [],
                "sep": "; ",
                "fmt": "{name}={value}",
                "target_field": "cookies.qimai",
                "required": true,
                "required_names": ["USERINFO", "aso_ucenter"],
                "min_count": 2
              }
            ]
          }
        },
        {
          "id": "rb",
          "name": "风鸟 (RiskBird)",
          "description": "Cookie copied from a logged-in riskbird.com session.",
          "fields": [
            {
              "key": "cookies.risk_bird",
              "label": "Cookie",
              "type": "secret_textarea",
              "required": true,
              "rows": 4
            }
          ],
          "test": {
            "kind": "exec",
            "cmd": "{{exec}} -n 小米 -type rb -field icp",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "fail_regex": "(?i)cookie\\s*expired|auth\\s*failed|安全验证",
            "timeout_secs": 60
          },
          "capture": {
            "login_url": "https://www.riskbird.com/",
            "success_url_pattern": "riskbird\\.com",
            "timeout_secs": 300,
            "instructions": "登录风鸟 RiskBird 后，Golish 会自动提取 riskbird.com 相关 Cookie 并写入 cookies.risk_bird 字段。",
            "rules": [
              {
                "type": "cookie_joined",
                "domain": ".riskbird.com",
                "names": [],
                "sep": "; ",
                "fmt": "{name}={value}",
                "target_field": "cookies.risk_bird",
                "required": true,
                "min_count": 3
              }
            ]
          }
        },
        {
          "id": "miit",
          "name": "MIIT ICP plugin",
          "description": "Token + Sign captured from the MIIT ICP backend (beian.miit.gov.cn).",
          "fields": [
            { "key": "miit.token", "label": "Token", "type": "secret_text", "required": true },
            { "key": "miit.sign", "label": "Sign", "type": "secret_text", "required": true }
          ],
          "test": {
            "kind": "exec",
            "cmd": "{{exec}} -n 小米 -type miit -field icp",
            "ok_regex": "(?i)company_name|company\\s*name|icp",
            "fail_regex": "(?i)token\\s*expired|sign\\s*invalid|auth\\s*failed",
            "timeout_secs": 30
          }
        }
      ]
    },
    "install": {
      "linux": {
        "method": "github",
        "source": "wgpsec/ENScan_GO"
      },
      "method": "github",
      "source": "wgpsec/ENScan_GO",
      "windows": {
        "method": "github",
        "source": "wgpsec/ENScan_GO"
      }
    },
    "launchMode": "cli",
    "name": "ENScan_GO",
    "output": {
      "detect": "ENScan|enterprise_info|icp|invest|branch|holds",
      "fields": {
        "app.bundle_id": "app_id",
        "app.link": "app_url",
        "app.name": "app_name",
        "branch.name": "subsidiary",
        "copyright.name": "software_copyright",
        "enterprise_info.email": "email",
        "enterprise_info.name": "organization_name",
        "enterprise_info.phone": "contact_phone",
        "enterprise_info.reg_code": "credit_code",
        "holds.name": "subsidiary",
        "holds.scale": "ownership_percent",
        "icp.company_name": "organization_name",
        "icp.domain": "domain",
        "invest.name": "subsidiary",
        "invest.pid": "provider_company_id",
        "invest.scale": "ownership_percent",
        "job.name": "job_title",
        "wechat.name": "social_account_name",
        "wechat.wechat_id": "wechat_id",
        "weibo.name": "social_account_name",
        "wx_app.name": "app_name"
      },
      "format": "json",
      "produces": [
        "organization",
        "domain",
        "business_system",
        "social_account",
        "contact",
        "intel"
      ]
    },
    "asset_intel_providers": [
      {
        "enabled": true,
        "provider_id": "enscan-go",
        "display_name": "ENScan_GO",
        "capabilities": ["subsidiaries"],
        "requires_integration": {
          "tool_id": "enscan-go",
          "group_ids": ["aqc"]
        },
        "auto": {
          "default": true,
          "priority": 100
        },
        "discovery": {
          "auto_promote": true,
          "promote_when": [
            { "field": "scale", "op": "gte", "value": "51" },
            { "field": "status", "op": "contains", "value": "开业" }
          ],
          "ownership_field": "scale",
          "dedupe_by": ["pid", "name"]
        },
        "runtime": {
          "kind": "cli_json",
          "skill_id": "company-default-json",
          "timeout_secs": 180,
          "artifact_globs": ["**/*.json"],
          "arg_bindings": {
            "min_ownership_percent": "-invest {{config.min_ownership_percent}}",
            "depth": "-deep {{config.depth}}",
            "include_branches": "-branch"
          }
        },
        "lookup": {
          "enabled": true,
          "skill_id": "company-lookup-json",
          "timeout_secs": 60,
          "normalize": {
            "path": "$..enterprise_info[*]",
            "name": "name",
            "credit_code": "reg_code",
            "legal_representative": "legal_person",
            "address": "address",
            "registered_at": "incorporation_date",
            "default_confidence": 0.68
          }
        },
        "normalize": {
          "organization": [
            { "path": "$..invest[*]", "label": "name", "value": "name", "confidence": 0.82 },
            { "path": "$..holds[*]", "label": "name", "value": "name", "confidence": 0.82 },
            { "path": "$..branch[*]", "label": "name", "value": "name", "confidence": 0.78 }
          ],
          "target": [
            { "path": "$..icp[*]", "label": "domain", "value": "domain", "confidence": 0.78 },
            { "path": "$..app[*]", "label": "name", "value": ["link", "app_url", "name"], "confidence": 0.68 },
            { "path": "$..wx_app[*]", "label": "name", "value": ["app_id", "name"], "confidence": 0.68 },
            { "path": "$..wechat[*]", "label": "name", "value": ["wechat_id", "id", "name"], "confidence": 0.62 },
            { "path": "$..weibo[*]", "label": "name", "value": ["weibo_id", "id", "name"], "confidence": 0.62 }
          ],
          "profile_fields": [
            { "path": "$..enterprise_info[*]", "source_field": "reg_code", "target_field": "credit_code", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "legal_person", "target_field": "legal_representative", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "address", "target_field": "registered_address", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "incorporation_date", "target_field": "registered_at", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "registered_capital", "target_field": "registered_capital", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "status", "target_field": "business_status", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "pid", "target_field": "aqc_pid", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "email", "target_field": "email", "target_kind": "contact", "transform": "lower", "when": [{ "field": "email", "op": "ne", "value": "-" }] },
            { "path": "$..enterprise_info[*]", "source_field": "phone", "target_field": "phone", "target_kind": "contact", "transform": "trim", "when": [{ "field": "phone", "op": "ne", "value": "-" }] }
          ]
        }
      },
      {
        "enabled": true,
        "provider_id": "enscan-go-enrichment",
        "display_name": "ENScan_GO · AQC Enrichment",
        "capabilities": ["domains", "icp", "apps", "mini_programs", "social_accounts", "contacts"],
        "requires_integration": {
          "tool_id": "enscan-go",
          "group_ids": ["aqc"]
        },
        "auto": {
          "default": true,
          "priority": 80
        },
        "runtime": {
          "kind": "cli_json",
          "skill_id": "company-enrichment-json",
          "timeout_secs": 180,
          "artifact_globs": ["**/*.json"]
        },
        "normalize": {
          "target": [
            { "path": "$..icp[*]", "label": "domain", "value": "domain", "confidence": 0.78 },
            { "path": "$..app[*]", "label": "name", "value": ["link", "app_url", "name"], "confidence": 0.68 },
            { "path": "$..wx_app[*]", "label": "name", "value": ["app_id", "name"], "confidence": 0.68 },
            { "path": "$..wechat[*]", "label": "name", "value": ["wechat_id", "id", "name"], "confidence": 0.62 },
            { "path": "$..weibo[*]", "label": "name", "value": ["weibo_id", "id", "name"], "confidence": 0.62 }
          ],
          "profile_fields": [
            { "path": "$..enterprise_info[*]", "source_field": "reg_code", "target_field": "credit_code", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "legal_person", "target_field": "legal_representative", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "address", "target_field": "registered_address", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "incorporation_date", "target_field": "registered_at", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "registered_capital", "target_field": "registered_capital", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "status", "target_field": "business_status", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "scope", "target_field": "business_scope", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "pid", "target_field": "aqc_pid", "target_kind": "intel", "transform": "trim" },
            { "path": "$..enterprise_info[*]", "source_field": "email", "target_field": "email", "target_kind": "contact", "transform": "lower", "when": [{ "field": "email", "op": "ne", "value": "-" }] },
            { "path": "$..enterprise_info[*]", "source_field": "phone", "target_field": "phone", "target_kind": "contact", "transform": "trim", "when": [{ "field": "phone", "op": "ne", "value": "-" }] },
            { "path": "$..icp[*]", "source_field": "domain", "target_field": "domains", "transform": "lower" },
            { "path": "$..icp[*]", "source_field": "website", "target_field": "business_systems", "transform": "lower" },
            { "path": "$..icp[*]", "source_field": "icp", "target_field": "icp_records", "target_kind": "intel", "transform": "trim" },
            { "path": "$..app[*]", "source_field": ["name", "link", "app_url"], "target_field": "mobile_apps", "target_kind": "intel", "transform": "trim" },
            { "path": "$..wx_app[*]", "source_field": ["name", "app_id"], "target_field": "mini_programs", "target_kind": "intel", "transform": "trim" },
            { "path": "$..wechat[*]", "source_field": ["wechat_id", "id", "name"], "target_field": "social_accounts", "transform": "trim" },
            { "path": "$..weibo[*]", "source_field": ["profile_url", "weibo_id", "id", "name"], "target_field": "social_accounts", "transform": "trim" }
          ]
        }
      },
