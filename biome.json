{
  "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json",
      "!frontend/lib/generated/**",
      "!backend/crates/*/bindings/generated/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useFocusableInteractive": "off",
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "warn"
      },
      "complexity": {
        "noCommaOperator": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "useImportType": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@tauri-apps/api/core": "Direct invoke() from Tauri is forbidden outside frontend/lib/api/. Use api.<domain>.<verb> from @/lib/api or a typed wrapper from @/lib/api/<domain>. See ADR-0009 Phase 2 and docs/development.md#adding-a-new-tauri-command-ipc.",
              "@/lib/api/client": "Direct facade-client invoke() from outside frontend/lib/api/ is discouraged. Use api.<domain>.<verb> from @/lib/api or a typed wrapper. See ADR-0009 Phase 2."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noControlCharactersInRegex": "off",
        "noDocumentCookie": "off",
        "noArrayIndexKey": "off",
        "noTemplateCurlyInString": "off",
        "noDuplicateObjectKeys": "warn",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "frontend/lib/**",
        "frontend/**/*.test.ts",
        "frontend/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["frontend/**/*.test.ts", "frontend/**/*.test.tsx"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "allowWrongLineComments": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": false
    }
  }
}
