{
  "id": "js_recon",
  "name": "JS Recon (built-in AI tools)",
  "description": "Capture JS bundles, extract API call-sites via regex+AST static analysis, then probe each endpoint for IDOR / unauth issues. Built-in AI tools — no external CLI binary needed. Use a URL like https://example.com as {target}.",
  "is_template": true,
  "workflow_id": "js_recon",
  "tags": ["recon", "ai", "js", "builtin"],
  "steps": [
    {
      "id": "js_collect",
      "step_type": "ai_tool",
      "tool_name": "js_collect",
      "command_template": "ai_tool:js_collect",
      "args": [],
      "params": {},
      "requires": "url",
      "on_failure": "abort",
      "x": 40,
      "y": 80
    },
    {
      "id": "js_extract_apis",
      "step_type": "ai_tool",
      "tool_name": "js_extract_apis",
      "command_template": "ai_tool:js_extract_apis",
      "args": [],
      "params": { "min_confidence": 0.5 },
      "requires": "url",
      "on_failure": "abort",
      "x": 260,
      "y": 80
    },
    {
      "id": "auth_probe",
      "step_type": "ai_tool",
      "tool_name": "auth_probe",
      "command_template": "ai_tool:auth_probe",
      "args": [],
      "params": {},
      "requires": "url",
      "on_failure": "continue",
      "x": 480,
      "y": 80
    }
  ],
  "connections": [
    { "from_step": "js_collect", "to_step": "js_extract_apis" },
    { "from_step": "js_extract_apis", "to_step": "auth_probe" }
  ]
}
