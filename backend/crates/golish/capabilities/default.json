{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Detached floating windows (label = detached-*) intentionally use the separate, minimal `detached` capability instead — see capabilities/detached.json and docs/risks/r10-tauri-capabilities.md.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-maximize",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "dialog:default",
    "shell:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-register-listener"
  ]
}
